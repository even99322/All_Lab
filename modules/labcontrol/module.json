{
  "id": "labcontrol",
  "name": "量測模塊",
  "version": "0.0.12",
  "kind": "desktop",
  "entry": "main.py",
  "python": "3.12",
  "requirements": "requirements.txt",
  "platforms": [
    "windows",
    "macos"
  ],
  "comm": {
    "actions": [
      "apply_scheme",
      "ping"
    ],
    "publishes": [
      "dataset.created"
    ]
  },
  "version_from": {
    "file": "labcontrol/__init__.py",
    "regex": "__version__\\s*=\\s*\"([^\"]+)\""
  },
  "package": {
    "exclude": [
      "tests",
      "labhub-data",
      "deploy/hub/data",
      "tools",
      "docs/releases"
    ]
  }
}
